{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Git Repo Migrator",
  "version": "0.1.0",
  "identifier": "com.gitrepo.migrator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    },
    "windows": [{
      "title": "Git Repo Migrator",
      "width": 1280,
      "height": 820,
      "minWidth": 960,
      "minHeight": 680,
      "resizable": true
    }]
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.ico", "icons/icon.png"] }
}
